{
  "name": "shadow-quant",
  "type": "module",
  "description": "A drag-and-drop toy for exploring and understanding small quantum circuits.",
  "license": "Apache-2.0",
  "version": "2.3.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/EnesSakalliUniWien/Quirk",
  "bugs": {
    "url": "https://github.com/EnesSakalliUniWien/Quirk/issues"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.0",
    "puppeteer": "25.8.0",
    "vite": "8.2.2"
  },
  "scripts": {
    "dev": "vite --open /quirk.html",
    "build": "vite build",
    "preview": "vite preview --open /quirk.html",
    "start": "node server/index.js",
    "serve": "npm run build && npm start",
    "check": "npm run test && npm run test:e2e && npm run test:perf",
    "test:build": "vite build --mode test",
    "test": "npm run test:build && node scripts/run-browser-tests.js test/test.html",
    "test:e2e": "npm run build && node scripts/run-e2e-tests.js",
    "test:perf:build": "vite build --mode perf",
    "test:perf": "npm run test:perf:build && node scripts/run-browser-tests.js test_perf/test_perf.html",
    "screenshot": "npm run build && node scripts/screenshot-circuit.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EnesSakalliUniWien/Quirk.git"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "lucide-react": "^1.33.0",
    "pixi.js": "8.20.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  }
}
