{
  "name": "shadow-quant",
  "type": "module",
  "description": "A drag-and-drop toy for exploring and understanding small quantum circuits.",
  "license": "Apache-2.0",
  "version": "2.3.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "homepage": "https://github.com/EnesSakalliUniWien/Quirk",
  "bugs": {
    "url": "https://github.com/EnesSakalliUniWien/Quirk/issues"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.0",
    "puppeteer": "25.8.0",
    "shadcn": "^4.18.0",
    "tailwindcss": "^4.3.3",
    "vite": "8.2.2"
  },
  "scripts": {
    "dev": "vite --open /quirk.html",
    "build": "vite build",
    "preview": "vite preview --open /quirk.html",
    "start": "node server/index.js",
    "serve": "npm run build && npm start",
    "test:build": "vite build --mode test",
    "test": "npm run test:build && node PuppeteerRunTests.js test.html",
    "test:e2e": "npm run build && node PuppeteerRunEndToEndTests.js",
    "test:perf:build": "vite build --mode perf",
    "test:perf": "npm run test:perf:build && node PuppeteerRunTests.js test_perf.html",
    "screenshot": "npm run build && node PuppeteerScreenshotCircuit.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/EnesSakalliUniWien/Quirk.git"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
