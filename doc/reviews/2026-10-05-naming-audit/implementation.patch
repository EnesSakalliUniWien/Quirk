+    Matrix.square(1, 0, 0, 1).times(
+      new Complex(Math.sqrt(0.5), -Math.sqrt(0.5)),
+    ),
+  ).gate;
+
+export {
+  AntiImaginaryGate,
+  ImaginaryGate,
+  SqrtImaginaryGate,
+  AntiSqrtImaginaryGate,
+};
