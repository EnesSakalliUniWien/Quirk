{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noEmit": true,
        "noImplicitAny": false,
        "paths": {
            "@/*": [
                "./src/*"
            ]
        },
        "skipLibCheck": true,
        "target": "esnext"
    },
    "include": [
        "src"
    ]
}
